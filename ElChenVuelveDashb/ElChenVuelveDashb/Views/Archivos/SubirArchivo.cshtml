@model IEnumerable<Archivo>

<div class="container mt-5">
    <h2>Cargar Archivos</h2>
    <form asp-action="Upload" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <input type="hidden" name="usuarioId" value="1" />
        </div>
        <div class="form-group">
            <label for="descripcion">Descripción</label>
            <input type="text" class="form-control" name="descripcion" required />
        </div>
        <div class="form-group">
            <label for="fileInput">Adjuntar archivo (máx. 5 MB):</label>
            <input type="file" class="form-control" id="fileInput" name="archivo" required />
        </div>
        <button type="submit" class="btn btn-primary mt-3">Cargar Archivo</button>
    </form>

    <h3 class="mt-5">Archivos Cargados</h3>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descripción</th>
                <th>Ruta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var archivo in Model)
            {
                <tr>
                    <td>@archivo.Id</td>
                    <td>@archivo.Descripcion</td>
                    <td><a href="@Url.Content(archivo.Ruta)" target="_blank">Descargar</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
